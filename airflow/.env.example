# Copy to airflow/.env (git-ignored). Astro loads it into the local Airflow containers.
# Databricks connection: workspace host and a personal access token. http_path is the SQL warehouse's HTTP path
# (SQL Warehouses -> your warehouse -> Connection details), used by the SQL check task.
AIRFLOW_CONN_DATABRICKS_DEFAULT='{"conn_type": "databricks", "host": "https://<your-workspace>.cloud.databricks.com", "password": "<token>", "extra": {"http_path": "/sql/1.0/warehouses/<warehouse-id>"}}'
METLINK_API_KEY=
# Deployed bundle target and resource names
METLINK_CATALOG=metlink
METLINK_PIPELINE_NAME=[dev <user>] metlink-realtime
METLINK_ML_JOB_NAME=[dev <user>] metlink-ml-arrival-delay
METLINK_BUNDLE_ROOT=/Workspace/Users/<user>/.bundle/metlink-realtime/dev/files
