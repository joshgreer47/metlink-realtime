# Copy to .env and fill in. Never commit .env.

# From https://opendata.metlink.org.nz (My account -> API key)
METLINK_API_KEY=

# Databricks workspace URL and a personal access token
# (User settings -> Developer -> Access tokens)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=

# Unity Catalog volume the poller uploads into (created by src/notebooks/00_setup)
METLINK_VOLUME_PATH=/Volumes/metlink/bronze/raw

# Poller tuning
POLL_INTERVAL_SECONDS=30
BATCH_SECONDS=300
# Hours between checks for a new static GTFS version (0 disables)
STATIC_REFRESH_HOURS=24
